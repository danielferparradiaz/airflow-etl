# Normalize to LF in the repository and in working copies on every platform.
#
# This matters on macOS: a Makefile or shell script checked out with CRLF line
# endings fails with errors such as "missing separator" or "$'\r': command not
# found". Docker Compose, DAG files, and the Makefile must all stay LF.
* text=auto eol=lf

# Shell scripts must never be CRLF.
*.sh text eol=lf
Makefile text eol=lf

# Compose / env / YAML / DAG sources.
docker-compose.yaml text eol=lf
docker-compose.yml text eol=lf
.env text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Keep empty placeholder files as-is.
.gitkeep -text

# Binary assets, if any are added later.
*.png binary
*.jpg binary
*.pdf binary
*.csv binary
*.parquet binary